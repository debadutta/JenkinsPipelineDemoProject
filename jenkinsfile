pipeline {
    agent any

    stages {

        stage('Clean') {
            steps {
                echo "Cleaning Project"
                bat "mvn clean"
            }
        }

        stage('Compile') {
            steps {
                echo "Compiling Project"
                bat "mvn compile"
            }
        }

        stage('Test') {
            steps {
                echo "Executing Tests"
                bat "mvn test"
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying Project"
            }
        }

    }
}
