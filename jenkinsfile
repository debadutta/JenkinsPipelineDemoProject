pipeline {
    agent any

       tools {
        maven 'Maven3'
    }

    stages {

        stage('Clean') {
            steps {
                echo "Cleaning Project"
                sh "mvn clean"
            }
        }

        stage('Compile') {
            steps {
                echo "Compiling Project"
                sh "mvn compile"
            }
        }

        stage('Test') {
            steps {
                echo "Executing Tests"
                sh "mvn test"
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying Project"
            }
        }

    }
}
